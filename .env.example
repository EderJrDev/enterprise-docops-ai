# Copie para .env e preencha os segredos. Não commite o .env.
# Dentro do Docker Compose, QDRANT_URL é sobrescrito para http://qdrant:6333.

# --- Aplicação ---
APP_NAME=Enterprise DocOps AI
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0
DATA_DIR=data
SAMPLE_DOCS_DIR=data/sample_docs
EVAL_DATASET_PATH=data/eval_dataset.json

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
API_REQUEST_TIMEOUT_SECONDS=60

# --- LLM: primário OpenAI, fallback Anthropic, último recurso Ollama ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# --- Embeddings (openai | local) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# --- Qdrant ---
# Vazio usa o servidor em QDRANT_URL. Preencha para o modo local, sem Docker.
QDRANT_PATH=
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=docops_documents
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=10
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=bm25

# --- Retrieval híbrido (pesos BM25 + denso devem somar 1.0) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEMANTIC_BREAKPOINT_TYPE=percentile
SEMANTIC_BREAKPOINT_AMOUNT=95
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
HYBRID_FUSION=rrf
HYBRID_BM25_WEIGHT=0.35
HYBRID_DENSE_WEIGHT=0.65

# --- Rerank (cohere | local) ---
RERANKER_PROVIDER=cohere
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Langfuse ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

# --- MCP ---
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_TRANSPORT=streamable-http

# --- Guardrails e human-in-the-loop ---
GUARDRAILS_ENABLED=true
PII_MASKING_ENABLED=true
PROMPT_INJECTION_DETECTION_ENABLED=true
MAX_INPUT_CHARS=8000
SPACY_MODEL=pt_core_news_sm
HITL_ENABLED=true
